{
  "name": "claude-code-tools-installer-desktop",
  "version": "2026.9.2204",
  "private": true,
  "license": "Apache-2.0",
  "description": "A safe desktop installer for a curated Claude Code tool stack.",
  "author": {
    "name": "SK America LLC",
    "email": "info@claudetool.app",
    "url": "https://claudetool.app"
  },
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "catalog:check": "node ../scripts/validate-catalog.js",
    "components:check": "node ../scripts/validate-components-catalog.js",
    "details:check": "node ../scripts/validate-catalog-details.js",
    "release:check": "node ../scripts/validate-macos-release-config.js",
    "ui:check": "node ../scripts/validate-desktop-ui.js",
    "duplicate-skill-ui:check": "node ../scripts/run-duplicate-skill-ui-test.js",
    "duplicate-skill:a11y": "node ../scripts/run-duplicate-skill-accessibility-audit.js",
    "duplicate-skill:audit-report": "node ../scripts/export-duplicate-skill-audit.js",
    "duplicate-skill:portability": "node ../scripts/test-duplicate-skill-portability.js",
    "setup-manager:check": "node ../scripts/test-setup-manager.js",
    "action-boundaries:check": "node ../scripts/test-desktop-action-boundaries.js",
    "complete-setup:check": "node ../scripts/test-complete-setup-verification.js",
    "mcp-registration:check": "node ../scripts/test-mcp-registration-idempotency.js",
    "setup-verification:check": "node ../scripts/run-setup-verification-controls-test.js",
    "diagnostics:check": "node ../scripts/test-desktop-diagnostics-services.js",
    "terminal-preference:check": "node ../scripts/test-terminal-preference.js",
    "terminal-adapters:check": "node ../scripts/test-terminal-adapters.js darwin && node ../scripts/test-terminal-adapters.js win32 && node ../scripts/test-terminal-adapters.js linux",
    "terminal-adapters:windows-runner": "node ../scripts/test-windows-terminal-adapter-runner.js",
    "updates:check": "node ../scripts/test-desktop-update-services.js",
    "updates:live-check": "node ../scripts/test-live-published-update.js",
    "release-identity:check": "node ../scripts/test-release-identity.js",
    "project-prerequisites:check": "node ../scripts/test-project-prerequisites.js",
    "project-interview:check": "node ../scripts/test-project-interview.js",
    "release-drift:check": "node ../scripts/test-release-artifact-drift.js",
    "release-workflows:check": "node ../scripts/test-release-workflow-safety.js",
    "linux-release-workflow:check": "node ../scripts/test-linux-release-workflow.js",
    "linux-release:verify": "node ../scripts/verify-linux-release-archive.js",
    "release-alert:check": "bash ../scripts/test-notify-release-drift.sh",
    "release-audit:check": "bash ../scripts/test-release-desktop-check.sh",
    "security:check": "node ../scripts/validate-security-remediation.js && npm audit --audit-level=high",
    "check": "npm run catalog:check && npm run components:check && npm run details:check && npm run ui:check && npm run duplicate-skill-ui:check && npm run duplicate-skill:a11y && npm run duplicate-skill:portability && npm run setup-manager:check && npm run action-boundaries:check && npm run complete-setup:check && npm run mcp-registration:check && npm run setup-verification:check && npm run diagnostics:check && npm run terminal-preference:check && npm run terminal-adapters:check && npm run updates:check && npm run release-identity:check && npm run update-metadata:check && npm run update-metadata:verify && npm run project-prerequisites:check && npm run project-interview:check && npm run release:check && npm run release-drift:check && npm run release-workflows:check && npm run linux-release-workflow:check && npm run release-alert:check && npm run release-audit:check && npm run security:check && node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js && node --check src/project-prerequisites.js && node --check src/project-interview.js && node --check src/release-identity.js && node --check build/notarize.js && node --check ../scripts/prepare-msix-config.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:mac:signed": "electron-builder --mac dmg zip --publish never --config.forceCodeSigning=true",
    "dist:mac:release": "NOTARIZE=1 electron-builder --mac dmg zip --publish never --config.forceCodeSigning=true",
    "dist:win": "electron-builder --win nsis --publish never",
    "windows-signing:prepare": "node ../scripts/prepare-windows-azure-signing-config.js --out build/windows-signed.resolved.json",
    "dist:win:unsigned:x64": "electron-builder --win nsis --x64 --publish never",
    "dist:win:signed:x64": "node ../scripts/prepare-windows-azure-signing-config.js --out build/windows-signed.resolved.json && electron-builder --win nsis --x64 --config build/windows-signed.resolved.json --publish never",
    "dist:win:zip": "electron-builder --win zip --publish never",
    "msix:prepare": "node ../scripts/prepare-msix-config.js --out build/appx-store.resolved.json",
    "dist:win:store": "node ../scripts/prepare-msix-config.js --out build/appx-store.resolved.json && electron-builder --win appx --config build/appx-store.resolved.json --publish never",
    "dist:win:store:x64": "node ../scripts/prepare-msix-config.js --out build/appx-store.resolved.json && electron-builder --win appx --x64 --config build/appx-store.resolved.json --publish never",
    "dist:win:store:arm64": "node ../scripts/prepare-msix-config.js --out build/appx-store.resolved.json && electron-builder --win appx --arm64 --config build/appx-store.resolved.json --publish never",
    "dist:linux": "electron-builder --linux tar.gz --publish never",
    "update-metadata:check": "node ../scripts/test-refresh-macos-update-metadata.js",
    "update-metadata:verify": "node ../scripts/test-verify-macos-update-metadata.js"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "electron": "^44.3.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.skamerica.claudecodetoolsinstaller",
    "productName": "Claude Code Tools Installer",
    "copyright": "Copyright © 2026 SK America LLC",
    "forceCodeSigning": false,
    "afterSign": "build/notarize.js",
    "artifactName": "Claude-Code-Tools-Installer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../releases/test-builds"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../setup-my-claude.sh",
        "to": "installers/setup-my-claude.sh"
      },
      {
        "from": "../setup-my-claude-linux.sh",
        "to": "installers/setup-my-claude-linux.sh"
      },
      {
        "from": "../setup-my-claude.ps1",
        "to": "installers/setup-my-claude.ps1"
      },
      {
        "from": "catalog.json",
        "to": "catalog.json"
      },
      {
        "from": "convex-components.json",
        "to": "convex-components.json"
      },
      {
        "from": "catalog-details.json",
        "to": "catalog-details.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Code Tools Installer"
    },
    "linux": {
      "target": [
        "tar.gz"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "SteveKinzey",
      "repo": "claude-code-tools-installer",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
